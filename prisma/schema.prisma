// CivicGrid — Prisma Database Schema
// PostgreSQL + Supabase compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CITIZEN
  FIELD_WORKER
  DEPARTMENT_OFFICER
  DISTRICT_OFFICER
  ADMINISTRATOR
}

enum Module {
  CIVICGRID_CORE
  SWASTHYAGRID
  SURAKSHAGRID
  MONSOONSHIELD
  HEATSAFE_INDIA
  SYSTEM
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ActionStatus {
  NEW
  REVIEWING
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  RESOLVED
  VERIFIED
  CLOSED
}

enum EventStatus {
  DETECTED
  ANALYZING
  CORRELATED
  PRIORITISED
  ACTION_CREATED
  ASSIGNED
  RESOLVED
  VERIFIED
}

enum EventSource {
  CITIZEN_REPORT
  GOVERNMENT_DATASET
  WEATHER
  SENSOR
  OFFICER
  SYSTEM_DETECTION
}

enum NotificationType {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum MissionStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum AssetType {
  HOSPITAL
  PHC
  SCHOOL
  BRIDGE
  POWER_SUBSTATION
  WATER_FACILITY
  EMERGENCY_SHELTER
  ROAD
  TELECOM_INFRASTRUCTURE
  GOVERNMENT_BUILDING
  DRAINAGE
  OTHER
}

enum ReportCategory {
  ROAD
  DRAINAGE
  WASTE
  STREETLIGHT
  WATER
  PUBLIC_BUILDING
  PUBLIC_TRANSPORT
  HEALTH
  OTHER
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING
}

// ============================================================
// CORE TABLES
// ============================================================

model Profile {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  passwordHash String? @map("password_hash")
  role        UserRole @default(CITIZEN)
  department  String?
  phone       String?
  avatarUrl   String?  @map("avatar_url")
  locationId  String?  @map("location_id")
  isActive    Boolean  @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  location           Location?          @relation(fields: [locationId], references: [id])
  assignedActions    Action[]           @relation("AssignedActions")
  createdActions     Action[]           @relation("CreatedActions")
  notifications      Notification[]
  auditLogs          AuditLog[]
  citizenReports     CitizenReport[]
  missionMemberships MissionMember[]

  @@map("profiles")
  @@index([role])
  @@index([department])
  @@index([locationId])
}

model Location {
  id          String  @id @default(uuid())
  name        String
  ward        String?
  district    String  @default("Hyderabad")
  state       String  @default("Telangana")
  latitude    Float?
  longitude   Float?
  geojson     Json?
  population  Int?
  createdAt   DateTime @default(now()) @map("created_at")

  profiles       Profile[]
  assets         Asset[]
  citizenReports CitizenReport[]
  events         Event[]
  actions        Action[]
  missions       Mission[]

  @@map("locations")
  @@index([district])
  @@index([ward])
}

// ============================================================
// INFRASTRUCTURE / ASSETS
// ============================================================

model Asset {
  id          String    @id @default(uuid())
  name        String
  type        AssetType
  locationId  String    @map("location_id")
  address     String?
  latitude    Float?
  longitude   Float?
  ward        String?
  department  String?
  capacity    Int?
  metadata    Json?     // flexible: beds, power_kv, water_capacity, etc.
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  location        Location         @relation(fields: [locationId], references: [id])
  riskAssessments RiskAssessment[]

  @@map("assets")
  @@index([type])
  @@index([locationId])
  @@index([ward])
}

// ============================================================
// CITIZEN REPORTS
// ============================================================

model CitizenReport {
  id              String         @id @default(uuid())
  submittedById   String?        @map("submitted_by_id")
  category        ReportCategory @default(OTHER)
  title           String
  description     String
  locationId      String?        @map("location_id")
  address         String?
  latitude        Float?
  longitude       Float?
  ward            String?
  severity        Priority?
  aiCategory      String?        @map("ai_category")
  aiSummary       String?        @map("ai_summary")
  aiDepartment    String?        @map("ai_department")
  aiConfidence    Float?         @map("ai_confidence")
  aiFactors       Json?          @map("ai_factors")
  aiProviderId    String?        @map("ai_provider_id")
  status          ActionStatus   @default(NEW)
  isAnonymous     Boolean        @default(false) @map("is_anonymous")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  submittedBy Profile?       @relation(fields: [submittedById], references: [id])
  location    Location?      @relation(fields: [locationId], references: [id])
  media       ReportMedia[]
  events      Event[]

  @@map("citizen_reports")
  @@index([category])
  @@index([status])
  @@index([ward])
  @@index([createdAt])
  @@index([locationId])
}

model ReportMedia {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  url         String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  report CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_media")
  @@index([reportId])
}

// ============================================================
// EVENTS
// ============================================================

model Event {
  id            String      @id @default(uuid())
  title         String
  description   String
  module        Module
  source        EventSource
  status        EventStatus @default(DETECTED)
  severity      Priority    @default(MEDIUM)
  locationId    String?     @map("location_id")
  ward          String?
  reportId      String?     @map("report_id")
  metadata      Json?
  detectedAt    DateTime    @default(now()) @map("detected_at")
  resolvedAt    DateTime?   @map("resolved_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  location        Location?        @relation(fields: [locationId], references: [id])
  report          CitizenReport?   @relation(fields: [reportId], references: [id])
  riskAssessments RiskAssessment[]
  actions         Action[]
  missionEvents   MissionEvent[]

  @@map("events")
  @@index([module])
  @@index([status])
  @@index([severity])
  @@index([locationId])
  @@index([detectedAt])
}

// ============================================================
// RISK & PRIORITY ENGINE
// ============================================================

model RiskAssessment {
  id                   String   @id @default(uuid())
  module               Module
  eventId              String?  @map("event_id")
  assetId              String?  @map("asset_id")
  locationId           String?  @map("location_id")
  ward                 String?
  priority             Priority
  priorityScore        Float    @map("priority_score")
  populationAffected   Int?     @map("population_affected")
  criticalFacilityProx Float?   @map("critical_facility_prox")
  reportCount          Int      @default(0) @map("report_count")
  recurrenceCount      Int      @default(0) @map("recurrence_count")
  severityScore        Float    @default(0) @map("severity_score")
  riskExposureScore    Float    @default(0) @map("risk_exposure_score")
  daysUnresolved       Int      @default(0) @map("days_unresolved")
  geoConcentration     Float?   @map("geo_concentration")
  factors              Json     // Array of { factor, value, weight, contribution }
  aiExplanation        String?  @map("ai_explanation")
  aiConfidence         Float?   @map("ai_confidence")
  aiProvider           String?  @map("ai_provider")
  reviewedBy           String?  @map("reviewed_by")
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  event  Event?  @relation(fields: [eventId], references: [id])
  asset  Asset?  @relation(fields: [assetId], references: [id])

  @@map("risk_assessments")
  @@index([module])
  @@index([priority])
  @@index([locationId])
  @@index([ward])
  @@index([createdAt])
}

// ============================================================
// ACTION CENTRE
// ============================================================

model Action {
  id                 String       @id @default(uuid())
  module             Module
  title              String
  description        String
  priority           Priority
  status             ActionStatus @default(NEW)
  locationId         String?      @map("location_id")
  ward               String?
  eventId            String?      @map("event_id")
  reason             String?
  recommendedAction  String?      @map("recommended_action")
  assignedDept       String?      @map("assigned_dept")
  assignedToId       String?      @map("assigned_to_id")
  createdById        String?      @map("created_by_id")
  dueAt              DateTime?    @map("due_at")
  resolvedAt         DateTime?    @map("resolved_at")
  aiGenerated        Boolean      @default(false) @map("ai_generated")
  aiApproved         Boolean?     @map("ai_approved")
  aiApprovedById     String?      @map("ai_approved_by_id")
  aiApprovedAt       DateTime?    @map("ai_approved_at")
  slaBreached        Boolean      @default(false) @map("sla_breached")
  metadata           Json?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  location   Location?        @relation(fields: [locationId], references: [id])
  event      Event?           @relation(fields: [eventId], references: [id])
  assignedTo Profile?         @relation("AssignedActions", fields: [assignedToId], references: [id])
  createdBy  Profile?         @relation("CreatedActions", fields: [createdById], references: [id])
  evidence   ActionEvidence[]

  @@map("actions")
  @@index([module])
  @@index([status])
  @@index([priority])
  @@index([ward])
  @@index([assignedDept])
  @@index([createdAt])
  @@index([dueAt])
}

model ActionEvidence {
  id          String   @id @default(uuid())
  actionId    String   @map("action_id")
  type        String   // "image", "note", "gps", "sensor"
  url         String?
  note        String?
  latitude    Float?
  longitude   Float?
  uploadedById String? @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_evidence")
  @@index([actionId])
}

// ============================================================
// MISSION MODE
// ============================================================

model Mission {
  id           String        @id @default(uuid())
  title        String
  description  String
  modules      Module[]
  status       MissionStatus @default(ACTIVE)
  priority     Priority      @default(HIGH)
  locationId   String?       @map("location_id")
  ward         String?
  startedAt    DateTime      @default(now()) @map("started_at")
  resolvedAt   DateTime?     @map("resolved_at")
  createdById  String?       @map("created_by_id")
  metadata     Json?         // summary stats
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  location Location?       @relation(fields: [locationId], references: [id])
  members  MissionMember[]
  events   MissionEvent[]

  @@map("missions")
  @@index([status])
  @@index([priority])
  @@index([locationId])
  @@index([startedAt])
}

model MissionMember {
  id         String   @id @default(uuid())
  missionId  String   @map("mission_id")
  profileId  String   @map("profile_id")
  role       String   @default("member")
  joinedAt   DateTime @default(now()) @map("joined_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id])

  @@unique([missionId, profileId])
  @@map("mission_members")
}

model MissionEvent {
  id        String   @id @default(uuid())
  missionId String   @map("mission_id")
  eventId   String   @map("event_id")
  addedAt   DateTime @default(now()) @map("added_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id])

  @@unique([missionId, eventId])
  @@map("mission_events")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id         String           @id @default(uuid())
  profileId  String           @map("profile_id")
  type       NotificationType
  title      String
  message    String
  module     Module?
  actionId   String?          @map("action_id")
  missionId  String?          @map("mission_id")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([profileId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================================
// AI OBSERVABILITY
// ============================================================

model AiRequest {
  id              String   @id @default(uuid())
  provider        String
  model           String
  task            String   // "classify", "summarize", "analyze_image", etc.
  module          Module?
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  latencyMs       Int?     @map("latency_ms")
  success         Boolean
  errorCode       String?  @map("error_code")
  errorMessage    String?  @map("error_message")
  fallbackUsed    Boolean  @default(false) @map("fallback_used")
  fallbackProvider String? @map("fallback_provider")
  cacheHit        Boolean  @default(false) @map("cache_hit")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("ai_requests")
  @@index([provider])
  @@index([success])
  @@index([createdAt])
  @@index([task])
}

model AiProviderHealth {
  id              String   @id @default(uuid())
  provider        String   @unique
  isOperational   Boolean  @default(true) @map("is_operational")
  successRate     Float    @default(1.0) @map("success_rate")
  avgLatencyMs    Int?     @map("avg_latency_ms")
  failureCount    Int      @default(0) @map("failure_count")
  lastFailureAt   DateTime? @map("last_failure_at")
  lastFailureCode String?  @map("last_failure_code")
  cooldownUntil   DateTime? @map("cooldown_until")
  totalRequests   Int      @default(0) @map("total_requests")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("ai_provider_health")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  action        String
  module        Module?
  resource      String?
  resourceId    String?  @map("resource_id")
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  aiRecommendation Json? @map("ai_recommendation")
  humanDecision Json?    @map("human_decision")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  user Profile? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([module])
  @@index([resource])
  @@index([createdAt])
}

// ============================================================
// DATA SOURCES (Government Integration Layer)
// ============================================================

model DataSource {
  id               String           @id @default(uuid())
  name             String
  provider         String
  module           Module
  endpoint         String?
  authMethod       String?          @map("auth_method")
  refreshFreqMins  Int?             @map("refresh_freq_mins")
  dataSchema       Json?            @map("data_schema")
  status           DataSourceStatus @default(PENDING)
  lastSyncAt       DateTime?        @map("last_sync_at")
  lastErrorMessage String?          @map("last_error_message")
  recordCount      Int?             @map("record_count")
  isDemo           Boolean          @default(false) @map("is_demo")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("data_sources")
  @@index([module])
  @@index([status])
}

// ============================================================
// MODULE CONFIGS
// ============================================================

model ModuleConfig {
  id        String  @id @default(uuid())
  module    Module  @unique
  isEnabled Boolean @default(true) @map("is_enabled")
  config    Json    @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("module_configs")
}
